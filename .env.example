# ---------------------------------------------------------------------------
# StoreIQ Simple Virtual Shield — environment variables
# Copy to .env for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Application role (NOT the schema owner). Subject to row-level security.
DATABASE_URL=postgresql://vshield_app:change-me-app@localhost:54329/vshield
# Schema owner, used only by `prisma migrate deploy` and admin scripts.
MIGRATION_DATABASE_URL=postgresql://postgres:change-me-owner@localhost:54329/vshield
# Password applied to the vshield_app role by `npm run db:setup-roles`.
APP_DB_PASSWORD=change-me-app

# Public base URL; used for Origin (CSRF) checks. Must match the browser origin.
APP_URL=http://localhost:3000

# Session lifetime in hours (absolute) and idle timeout in minutes.
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# Storage: "local" (development) or "s3" (production, private bucket).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage-data
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Credentials: prefer IAM roles / workload identity. Only set these if required.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
DOWNLOAD_URL_TTL_SECONDS=60

# Upload and processing limits.
MAX_UPLOAD_BYTES=209715200
MAX_ROWS_PER_JOB=1000000
MAX_STORED_ROW_ERRORS=5000
JOB_TIMEOUT_SECONDS=1800

# Retention (days). 0 disables the cleanup for that category.
RETENTION_UPLOAD_FILES_DAYS=30
RETENTION_RAW_OBSERVATIONS_DAYS=30

# Rate limits.
LOGIN_RATE_LIMIT_PER_15MIN=10
API_WRITE_RATE_LIMIT_PER_MIN=120

# Worker.
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=1

LOG_LEVEL=info
